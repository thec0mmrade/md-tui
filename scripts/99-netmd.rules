# NetMD device udev rules
# Install: sudo cp 99-netmd.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger

# Sharp NetMD devices
SUBSYSTEM=="usb", ATTRS{idVendor}=="04dd", ATTRS{idProduct}=="7202", MODE="0666", GROUP="wheel"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04dd", ATTRS{idProduct}=="9013", MODE="0666", GROUP="wheel"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04dd", ATTRS{idProduct}=="9014", MODE="0666", GROUP="wheel"

# Sony NetMD devices
